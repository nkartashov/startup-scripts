#!/usr/bin/env python3
import sys
import json
import subprocess
from datetime import datetime, timezone

def exec_cmd(*args) -> bool:
    """Run a command; return True if the program exists and was started."""
    try:
        # We don't care about the exit code here—just that it ran.
        subprocess.run(args, check=False)
        return True
    except FileNotFoundError:
        return False

def notify(title: str, description: str) -> None:
    # Linux / *BSD (libnotify)
    if exec_cmd("notify-send", "--expire-time=5000", title, description):
        return

    # macOS (JXA via osascript)
    js = (
        "var app = Application.currentApplication();\n"
        "app.includeStandardAdditions = true;\n"
        f"app.displayNotification({json.dumps(description)}, "
        f"{{ withTitle: {json.dumps(title)} }});\n"
    )
    if exec_cmd("osascript", "-l", "JavaScript", "-e", js):
        return

    # Fallback
    sys.stderr.write("can't send notifications\n")
    sys.exit(1)

def main() -> None:
    title = sys.argv[1] if len(sys.argv) > 1 else "Notification"
    # ISO 8601 with local timezone offset
    default_desc = datetime.now(timezone.utc).astimezone().isoformat()
    description = sys.argv[2] if len(sys.argv) > 2 else default_desc
    notify(title, description)

if __name__ == "__main__":
    main()
